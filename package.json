{
  "name": "experiencias-somos-diseno",
  "version": "1.0.0",
  "private": true,
  "description": "Hub de experiencias interactivas y herramientas de Somos Diseño para Tablet y Desktop",
  "scripts": {
    "dev": "npx serve -l 8080 .",
    "dev:hub": "npx serve -l 8080 .",
    "dev:fotomaton": "npm --prefix fotomaton run dev",
    "dev:fotomaton:tablet": "npm --prefix fotomaton run dev:tablet",
    "dev:mosaicos": "npm --prefix taller-mosaicos run dev",
    "dev:mosaicos:tablet": "npm --prefix taller-mosaicos run dev:tablet",
    "dev:loops": "npm --prefix loops run dev",
    "dev:loops:tablet": "npm --prefix loops run dev:tablet",
    "dev:graffiti": "npm --prefix graffiti run dev",
    "dev:graffiti:tablet": "npm --prefix graffiti run dev:tablet",
    "dev:credencial": "npm --prefix credencial run dev",
    "dev:credencial:movil": "npm --prefix credencial run dev:movil",
    "dev:hub-estacion": "npm --prefix hub-estacion run dev",
    "build:fotomaton": "npm --prefix fotomaton run build",
    "build:mosaicos": "npm --prefix taller-mosaicos run build",
    "build:loops": "npm --prefix loops run build",
    "build:graffiti": "npm --prefix graffiti run build",
    "build:credencial": "npm --prefix credencial run build",
    "build:hub-estacion": "npm --prefix hub-estacion run build",
    "build": "npm run build:fotomaton && npm run build:mosaicos && npm run build:loops && npm run build:graffiti && npm run build:credencial && npm run build:hub-estacion",
    "build:all": "npm run build"
  },
  "devDependencies": {
    "serve": "^14.2.4"
  }
}
